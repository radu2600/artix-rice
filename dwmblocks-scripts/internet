#!/bin/sh

# Show wifi 📶 and percent strength or 📡 if none.
# Show 🌐 if connected to ethernet or ❎ if none.
# Show 🔒 if a vpn connection is active

case $BLOCK_BUTTON in
	1) "$TERMINAL" -e nmtui; pkill -RTMIN+6 dwmblocks ;;
	3) notify-send "🌐 Internet module" "\- Click to connect
❌: wifi disabled
📡: no wifi connection
📶: wifi connection with quality
" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac


wifi_iface="wlan0"

if [ "$(cat /sys/class/net/$wifi_iface/operstate 2>/dev/null)" = "up" ]; then
    # Get signal in dBm
    signal_dBm=$(iw dev $wifi_iface link | awk '/signal:/ {print $2}')
    
    if [ -n "$signal_dBm" ]; then
        # Convert dBm (-100 to -30) to percent 0-100
        signal_percent=$(( (signal_dBm + 100) * 100 / 70 ))
        [ $signal_percent -gt 100 ] && signal_percent=100
        [ $signal_percent -lt 0 ] && signal_percent=0
        wifiicon="📶 ${signal_percent}%"
    else
        wifiicon="📶?"
    fi
else
    wifiicon="❌"
fi

printf "[%s]\n" "$wifiicon"

